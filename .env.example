# ─────────────────────────────────────────────────────────────
# TERNESITO® — environment configuration
# Copy this file to `.env.local` and fill in real values.
# ─────────────────────────────────────────────────────────────

# Webhook that receives the contact form as a JSON POST:
# { name, email, message, source }
# Works with Formspree, n8n, Make, Zapier or your own API.
# If left empty, the contact form falls back to opening the
# visitor's email app (mailto).
CONTACT_WEBHOOK_URL=
